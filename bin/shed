#!/usr/bin/env bash
#
# shed - manage shed dotfiles
#
#   shed install    symlink shed dotfiles into $HOME (leaf-level, merge-safe).
#                   idempotent: re-run any time to converge -- link new files,
#                   repoint links after the shed dir moves, prune links whose
#                   source left the tree, evict links from newly ignored paths
#   shed ignore     add paths to the ignore set; with no paths, list it
#   shed unignore   remove paths from the ignore set (interactive without args)
#   shed uninstall  remove all symlinks shed created in $HOME
#
# real directories are created in $HOME and individual files are symlinked, so
# dot/, os/<os>/dot/ and private/dot/ can all contribute files to the same
# directory (e.g. ~/.ssh) without either clobbering the other.
# precedence: private/dot beats os/<os>/dot beats dot. real files are backed up.
#
# ignored paths are user territory: shed never links into or below them.
# ignore/unignore only edit the persisted set; install applies it, evicting
# shed's own links from newly ignored paths (backups stay put).
#
# every link shed creates is recorded in a manifest (state dir) so a later
# install or uninstall can find it again even after the shed directory has
# moved. the ignore set lives in the config dir and survives uninstall.
#

set -euo pipefail

# ---- colors ----------------------------------------------------------------

if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ -n "${TERM:-}" ]; then
    RST=$(tput sgr0);    BLD=$(tput bold);     ITL=$(tput sitm);
    RED=$(tput setaf 1); GRN=$(tput setaf 2);  YLW=$(tput setaf 3);
    BLU=$(tput setaf 4); CYN=$(tput setaf 6);  DIM=$(tput dim)
else
    BLD=; DIM=; ITL=; RST=; RED=; GRN=; YLW=; BLU=; CYN=
fi

IND=""   # extra indent prepended to run/act output (set within the link phase)

say()    { printf '%s\n' "$*"; }
hdr()    { printf '\n%s%s%s\n' "$BLD$CYN" "$*" "$RST"; }
field()  { printf '  %s%-6s%s %s\n' "$DIM" "$1" "$RST" "$2"; }   # label + value
warn()   { printf '%swarning:%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()    { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit "${2:-1}"; }
# act <color> <label> <msg> -- an aligned, colorized action line
act()    { printf '%s  %s%-9s%s %s\n' "$IND" "$1" "$2" "$RST" "$3"; }
tilde()  { case "$1" in "$HOME"|"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

usage() {
    cat <<EOF
${BLD}shed${RST} - manage shed dotfiles

${BLD}usage:${RST} shed <command> [options] [path ...]

${BLD}commands:${RST}
  ${GRN}install${RST}     symlink shed dotfiles into \$HOME (merge-safe, idempotent;
              re-run any time to converge)
  ${GRN}ignore${RST}      add paths to the ignore set; with no paths, list it
  ${GRN}unignore${RST}    remove paths from the ignore set; with no paths, pick
              from a list
  ${GRN}uninstall${RST}   remove all symlinks shed created in \$HOME
  ${GRN}help${RST}        show this message

${BLD}options:${RST}
  -n, --dry-run           show what would change without touching anything
  -S, --skip-modules      install: do not init/pull git submodules
  -a, --all               unignore: clear the entire ignore set
EOF
}

# ---- args ------------------------------------------------------------------

CMD=""
DRY_RUN=0
SKIP_SUBMODULES=0
ALL=0
PATHS=()

bad_usage() { printf '%serror:%s %s\n\n' "$RED" "$RST" "$*" >&2; usage >&2; exit 2; }

case "${1:-}" in
    install|uninstall|ignore|unignore) CMD="$1"; shift ;;
    help|-h|--help)                    usage; exit 0 ;;
    "")                                usage >&2; exit 2 ;;
    *)                                 bad_usage "unknown command: $1" ;;
esac

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run)      DRY_RUN=1 ;;
        -S|--skip-modules) SKIP_SUBMODULES=1 ;;
        -a|--all)          ALL=1 ;;
        -*)                bad_usage "unknown option: $arg" ;;
        *)
            case "$CMD" in
                ignore|unignore) ;;
                *) bad_usage "$CMD takes no path arguments" ;;
            esac
            case "$arg" in
                "~")   arg="$HOME" ;;
                "~/"*) arg="$HOME/${arg#"~/"}" ;;
                /*)    ;;
                *)     arg="$PWD/$arg" ;;
            esac
            PATHS+=("${arg%/}")
            ;;
    esac
done

if [ "$ALL" -eq 1 ] && [ "$CMD" != "unignore" ]; then
    bad_usage "--all only applies to unignore"
fi

# ---- locate shed -----------------------------------------------------------

# resolve this file's symlink chain to find the shed root
_shed_src="${BASH_SOURCE[0]:-$0}"
while [ -L "$_shed_src" ]; do
    _shed_link="$(readlink "$_shed_src")"
    case "$_shed_link" in
        /*) _shed_src="$_shed_link" ;;
        *)  _shed_src="$(dirname "$_shed_src")/$_shed_link" ;;
    esac
done
SHED_ROOT="$(cd "$(dirname "$_shed_src")/.." >/dev/null 2>&1 && pwd)"
unset _shed_src _shed_link

SHED_OS="$(bash "$SHED_ROOT/bin/whatsmyos" 2>/dev/null || echo unknown)"
STAMP="$(date +%Y%m%d%H%M%S)"
MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/shed/manifest"
IGNORE="${XDG_CONFIG_HOME:-$HOME/.config}/shed/ignore"

run() { if [ "$DRY_RUN" -eq 1 ]; then printf '%s  %s[dry-run]%s %s\n' "$IND" "$DIM" "$RST" "$*"; else "$@"; fi; }

# ---- ignore set -------------------------------------------------------------
#
# one path per line in $IGNORE. throughout, ${arr[@]+"${arr[@]}"} guards
# expansions: bash 3.2 treats an empty array as unset under set -u.

IGNORES=()

# returns 0 if path or any child is in IGNORES
is_ignored() {
    local p="${1%/}" i
    for i in ${IGNORES[@]+"${IGNORES[@]}"}; do
        case "$p" in "$i"|"$i"/*) return 0 ;; esac
    done
    return 1
}

read_ignore() {
    IGNORES=()
    [ -e "$IGNORE" ] || return 1
    if [ ! -r "$IGNORE" ]; then
        warn "ignore file exists but is unreadable: $IGNORE"
        return 2
    fi
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        IGNORES+=("${line%/}")
    done < "$IGNORE"
    return 0
}

# persist IGNORES; an empty set means no file at all
write_ignore() {
    [ "$DRY_RUN" -eq 1 ] && return 0
    local dir; dir="$(dirname "$IGNORE")"
    if [ "${#IGNORES[@]}" -eq 0 ]; then
        rm -f "$IGNORE" 2>/dev/null || true
        rmdir "$dir" 2>/dev/null || true
        return 0
    fi
    if ! mkdir -p "$dir" 2>/dev/null; then
        warn "could not create config dir $dir (ignore set not saved)"
        return 0
    fi
    printf '%s\n' "${IGNORES[@]}" > "$IGNORE" 2>/dev/null || warn "could not write ignore file: $IGNORE"
}

# ---- manifest --------------------------------------------------------------
#
# each line is "<dst>\t<srcrel>" where srcrel is the source path relative to the
# shed root (e.g. dot/.bashrc). srcrel lets us recognize a link as ours even
# after the shed directory has moved, since the tail of its target still matches.

MANIFEST_LINES=()   # collected as "<dst>\t<srcrel>" during a link pass

record_link() { MANIFEST_LINES+=("$1"$'\t'"$2"); }

# a link is "ours" if it's a symlink whose target's tail matches the srcrel we
# recorded -- true whether it points at the current shed root or a stale one.
is_our_link() {
    local dst="$1" srcrel="$2" tgt
    [ -L "$dst" ] || return 1
    tgt="$(readlink "$dst")"
    case "$tgt" in
        */"$srcrel"|"$srcrel") return 0 ;;
        *) return 1 ;;
    esac
}

# read the manifest into parallel arrays MF_DST / MF_REL; tolerates absence and
# reports (without failing) when the file exists but can't be read.
MF_DST=(); MF_REL=()
read_manifest() {
    MF_DST=(); MF_REL=()
    [ -e "$MANIFEST" ] || return 1
    if [ ! -r "$MANIFEST" ]; then
        warn "manifest exists but is unreadable: $MANIFEST"
        return 2
    fi
    local dst rel
    while IFS=$'\t' read -r dst rel || [ -n "$dst" ]; do
        [ -n "$dst" ] || continue
        MF_DST+=("$dst"); MF_REL+=("$rel")
    done < "$MANIFEST"
    return 0
}

# dedupe by dst keeping the last (highest-precedence) entry, preserving order
write_manifest() {
    [ "$DRY_RUN" -eq 1 ] && return 0
    local dir; dir="$(dirname "$MANIFEST")"
    if ! mkdir -p "$dir" 2>/dev/null; then
        warn "could not create state dir $dir (skipping manifest)"
        warn "(uninstall won't be able to find these links later)"
        return 0
    fi
    local content=""
    if [ "${#MANIFEST_LINES[@]}" -gt 0 ]; then
        content="$(printf '%s\n' "${MANIFEST_LINES[@]}" |
            awk -F'\t' '{l[NR]=$0; k[NR]=$1; last[$1]=NR}
                        END{for(i=1;i<=NR;i++) if(last[k[i]]==i) print l[i]}')"
    fi
    if [ -n "$content" ]; then
        printf '%s\n' "$content" > "$MANIFEST" 2>/dev/null || warn "could not write manifest: $MANIFEST"
    else
        : > "$MANIFEST" 2>/dev/null || warn "could not write manifest: $MANIFEST"
    fi
}

# ---- linking ---------------------------------------------------------------

link_one() {
    local src="$1" dst="$2" srcrel dstdir cur bak
    srcrel="${src#"$SHED_ROOT"/}"
    dstdir="$(dirname "$dst")"
    [ -d "$dstdir" ] || run mkdir -p "$dstdir"

    record_link "$dst" "$srcrel"

    if [ -L "$dst" ]; then
        cur="$(readlink "$dst")"
        [ "$cur" = "$src" ] && return 0          # already correct, idempotent
        act "$YLW" "override:" "${dst#$HOME/}"
        printf '%s            %s%s -> %s%s\n' "$IND" "$DIM" "$cur" "$src" "$RST"
        run rm -f "$dst"
    elif [ -e "$dst" ]; then
        bak="$dst.bak.$STAMP"
        act "$YLW" "backup:" "${dst#$HOME/} -> ${bak##*/}"
        run mv "$dst" "$bak"
    fi

    run ln -s "$src" "$dst"
    act "$GRN" "link:" "${dst#$HOME/}"
}

link_tree() {
    local root="$1" f rel
    [ -d "$root" ] || return 0
    printf '  %sfrom %s%s\n' "$DIM" "${root#$SHED_ROOT/}" "$RST"
    IND="  "
    while IFS= read -r -d '' f; do
        rel="${f#"$root"/}"
        local dst="$HOME/$rel"
        if is_ignored "$dst"; then
            continue
        fi
        link_one "$f" "$dst"
    done < <(find "$root" -type f -print0)
    IND=""
}

# link in ascending precedence: base, then os-specific, then private
link_all() {
    link_tree "$SHED_ROOT/dot"
    link_tree "$SHED_ROOT/os/$SHED_OS/dot"
    link_tree "$SHED_ROOT/private/dot"
}

# secure ssh: dir 700, and repo-side files 600 (ssh checks the real file)
secure_ssh() {
    local sshdir="$HOME/.ssh"
    if is_ignored "$sshdir"; then return 0; fi
    [ -e "$sshdir" ] || return 0
    hdr "securing ~/.ssh"
    run chmod 700 "$sshdir"
    local d f
    for d in "$SHED_ROOT/dot/.ssh" "$SHED_ROOT/os/$SHED_OS/dot/.ssh" "$SHED_ROOT/private/dot/.ssh"; do
        [ -d "$d" ] || continue
        while IFS= read -r -d '' f; do
            run chmod 600 "$f"
        done < <(find "$d" -type f -print0)
    done
}

# ---- submodules ------------------------------------------------------------

show_submodules() {
    [ -f "$SHED_ROOT/.gitmodules" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    if [ "$SKIP_SUBMODULES" -eq 1 ]; then
        hdr "modules $ITL(skipped)$RST"
    else
        hdr "modules"
    fi
    git config --file "$SHED_ROOT/.gitmodules" --get-regexp '^submodule\..*\.path$' |
        while read -r key path; do
            local name url
            name=${key#submodule.}; name=${name%.path}
            url=$(git config --file "$SHED_ROOT/.gitmodules" --get "submodule.$name.url" || true)
            printf '  %s%-14s%s %s\n' "$DIM" "$path" "$RST" "$url"
        done || true
}

init_submodules() {
    [ -f "$SHED_ROOT/.gitmodules" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    if [ "$DRY_RUN" -eq 1 ]; then
        run git -C "$SHED_ROOT" submodule update --init --recursive
    elif ! git -C "$SHED_ROOT" submodule update --init --recursive; then
        printf '%s\n' "$YLW"
        say "| Could not init submodules. Do you have access?"
        say "| We'll skip for now. Once you can reach the repo, run:"
        say "|   git -C \"$SHED_ROOT\" submodule update --init --recursive"
        say "| then re-run shed install."
        printf '%s\n' "$RST"
    fi
}

# ---- shared preamble / epilogue -------------------------------------------

preamble() {
    printf '%senvironment%s\n' "$BLD$CYN" "$RST"
    field "os"   "$SHED_OS"
    field "shed" "$SHED_ROOT"
    local i label="ignore"
    for i in ${IGNORES[@]+"${IGNORES[@]}"}; do
        field "$label" "$(tilde "$i")"
        label=""
    done
    if [ "$DRY_RUN" -eq 1 ]; then printf '  %s(dry run, nothing will change)%s\n' "$DIM" "$RST"; fi
}

epilogue() {
    hdr "done"
    say "$*"
    [ "$DRY_RUN" -eq 1 ] && printf '%s(re-run without -n to apply)%s\n' "$DIM" "$RST" || true
}

# ---- commands --------------------------------------------------------------

cmd_install() {
    read_ignore || true

    preamble
    show_submodules
    if [ "$SKIP_SUBMODULES" -eq 0 ]; then
        init_submodules
    fi

    # previous links, to converge against below
    read_manifest || true

    # relink the current tree; link_one repoints any stale (moved) symlinks
    hdr "linking"
    link_all

    # prune tracked links that shouldn't exist anymore: destination newly
    # ignored (evict -- that territory is the user's) or source left the shed
    # tree. only ever touches links that are ours.
    local new_dsts=$'\n' line
    for line in ${MANIFEST_LINES[@]+"${MANIFEST_LINES[@]}"}; do
        new_dsts="$new_dsts${line%%$'\t'*}"$'\n'
    done
    local i b pruned=0
    for ((i = 0; i < ${#MF_DST[@]}; i++)); do
        case "$new_dsts" in *$'\n'"${MF_DST[$i]}"$'\n'*) continue ;; esac
        is_our_link "${MF_DST[$i]}" "${MF_REL[$i]}" || continue
        [ "$pruned" -gt 0 ] || hdr "pruning"
        pruned=$((pruned + 1))
        if is_ignored "${MF_DST[$i]}"; then
            act "$YLW" "evict:" "${MF_DST[$i]#$HOME/} (now ignored)"
            for b in "${MF_DST[$i]}".bak.*; do
                [ -e "$b" ] &&
                    printf '            %sbackup left in place: %s%s\n' "$DIM" "${b#$HOME/}" "$RST"
            done
        else
            act "$RED" "remove:" "${MF_DST[$i]#$HOME/} (no longer in shed)"
        fi
        run rm -f "${MF_DST[$i]}"
    done

    write_manifest
    secure_ssh

    local extra=""
    [ "$pruned" -gt 0 ] && extra=", removed $pruned old link(s)"
    epilogue "installed ${#MANIFEST_LINES[@]} dotfile(s)$extra"
}

cmd_ignore() {
    read_ignore || true

    if [ "${#PATHS[@]}" -eq 0 ]; then
        if [ "${#IGNORES[@]}" -eq 0 ]; then
            say "nothing is ignored."
        else
            local i
            for i in "${IGNORES[@]}"; do printf '  %s\n' "$(tilde "$i")"; done
        fi
        return 0
    fi

    local p added=0
    for p in "${PATHS[@]}"; do
        if is_ignored "$p"; then
            act "$DIM" "kept:" "$(tilde "$p") (already ignored)"
        else
            IGNORES+=("$p")
            act "$YLW" "ignore:" "$(tilde "$p")"
            added=$((added + 1))
        fi
    done
    write_ignore

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '%s(dry run, ignore set unchanged)%s\n' "$DIM" "$RST"
    elif [ "$added" -gt 0 ]; then
        say "run ${BLD}shed install${RST} to apply (evicts shed links under ignored paths)"
    fi
}

cmd_unignore() {
    read_ignore || true

    if [ "${#IGNORES[@]}" -eq 0 ]; then
        say "nothing is ignored."
        return 0
    fi

    local -a drop=()
    local p i
    if [ "$ALL" -eq 1 ]; then
        drop=("${IGNORES[@]}")
    elif [ "${#PATHS[@]}" -gt 0 ]; then
        local found
        for p in "${PATHS[@]}"; do
            found=0
            for i in "${IGNORES[@]}"; do
                [ "$i" = "$p" ] && { drop+=("$p"); found=1; break; }
            done
            if [ "$found" -eq 0 ]; then
                if is_ignored "$p"; then
                    warn "$(tilde "$p") is covered by a parent entry; unignore that instead"
                else
                    warn "$(tilde "$p") is not ignored"
                fi
            fi
        done
    else
        [ -t 0 ] || die "no terminal to pick from; pass paths or --all"
        for ((i = 0; i < ${#IGNORES[@]}; i++)); do
            printf '  %s%2d)%s %s\n' "$DIM" "$((i + 1))" "$RST" "$(tilde "${IGNORES[$i]}")"
        done
        printf 'unignore which? [numbers, %sa%sll, enter to cancel] ' "$BLD" "$RST"
        local reply n
        read -r reply || reply=""
        case "$reply" in
            "")    say "cancelled."; return 0 ;;
            a|all) drop=("${IGNORES[@]}") ;;
            *)
                for n in ${reply//,/ }; do
                    case "$n" in *[!0-9]*|"") die "invalid selection: $n" ;; esac
                    if [ "$n" -lt 1 ] || [ "$n" -gt "${#IGNORES[@]}" ]; then
                        die "out of range: $n"
                    fi
                    drop+=("${IGNORES[$((n - 1))]}")
                done
                ;;
        esac
    fi

    [ "${#drop[@]}" -gt 0 ] || return 0

    local -a keep=()
    local d hit removed=0
    for i in "${IGNORES[@]}"; do
        hit=0
        for d in "${drop[@]}"; do [ "$d" = "$i" ] && { hit=1; break; }; done
        if [ "$hit" -eq 1 ]; then
            act "$GRN" "unignore:" "$(tilde "$i")"
            removed=$((removed + 1))
        else
            keep+=("$i")
        fi
    done
    IGNORES=(${keep[@]+"${keep[@]}"})
    write_ignore

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '%s(dry run, ignore set unchanged)%s\n' "$DIM" "$RST"
    elif [ "$removed" -gt 0 ]; then
        say "run ${BLD}shed install${RST} to link into these paths again"
    fi
}

cmd_uninstall() {
    read_ignore || true
    preamble

    local rc=0
    read_manifest || rc=$?
    if [ "$rc" -ne 0 ]; then
        case "$rc" in
            2) die "cannot uninstall without a readable manifest" ;;
            *) hdr "nothing to do"
               say "no manifest at $MANIFEST"
               say "(run 'shed install' first)"
               return 0 ;;
        esac
    fi
    if [ "${#MF_DST[@]}" -eq 0 ]; then
        hdr "nothing to do"
        say "manifest is empty."
        run rm -f "$MANIFEST"
        return 0
    fi

    hdr "removing links"
    local i dst rel removed=0 kept=0 baks=() b
    for ((i = 0; i < ${#MF_DST[@]}; i++)); do
        dst="${MF_DST[$i]}"; rel="${MF_REL[$i]}"
        if is_our_link "$dst" "$rel"; then
            act "$RED" "remove:" "${dst#$HOME/}"
            run rm -f "$dst"
            removed=$((removed + 1))
        elif [ -e "$dst" ] || [ -L "$dst" ]; then
            act "$DIM" "skip:" "${dst#$HOME/} (not a shed link, left alone)"
            kept=$((kept + 1))
        fi
        for b in "$dst".bak.*; do [ -e "$b" ] && baks+=("$b"); done
    done

    if [ "${#baks[@]}" -gt 0 ]; then
        hdr "backups left in place"
        say "restore any of these by hand if you want them back:"
        for b in "${baks[@]}"; do printf '  %s%s%s\n' "$DIM" "$b" "$RST"; done
    fi

    run rm -f "$MANIFEST"

    local extra=""
    [ "$kept" -gt 0 ] && extra=", left $kept untouched"
    epilogue "removed $removed link(s)$extra"
}

case "$CMD" in
    install)   cmd_install ;;
    ignore)    cmd_ignore ;;
    unignore)  cmd_unignore ;;
    uninstall) cmd_uninstall ;;
esac
