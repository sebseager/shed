#!/usr/bin/env bash
#
# shed - manage shed dotfiles
#
#   shed install    symlink shed dotfiles into $HOME (leaf-level, merge-safe).
#                   idempotent: re-run any time to converge -- link new files,
#                   repoint links after the shed dir moves, prune links whose
#                   source left the tree, evict links from newly ignored paths.
#                   from a terminal it shows the changes and asks first;
#                   --yes (or no terminal) takes the default answers instead
#   shed ignore     add paths to the ignore set; with no paths, list it
#   shed unignore   remove paths from the ignore set (interactive without args)
#   shed uninstall  remove all symlinks shed created in $HOME
#
# real directories are created in $HOME and individual files are symlinked, so
# dot/, os/<os>/dot/ and private/dot/ can all contribute files to the same
# directory (e.g. ~/.ssh) without either clobbering the other.
# precedence: private/dot beats os/<os>/dot beats dot. anything of yours in the
# way (a real file, or a symlink that shed did not create) is backed up first.
#
# agents/ (and private/agents/) hold instruction files for coding agents.
#
# ignored paths are user territory: shed never links into or below them.
# ignore/unignore only edit the persisted set; install applies it, evicting
# shed's own links from newly ignored paths (backups stay put).
#
# every link shed creates is recorded in a manifest (state dir) so a later
# install or uninstall can find it again even after the shed directory has
# moved. the ignore set lives in the config dir and survives uninstall.
#

set -euo pipefail

# ---- colors ----------------------------------------------------------------

if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ -n "${TERM:-}" ]; then
    # a terminal missing a capability (TERM=dumb has none) just goes without
    t() { tput "$@" 2>/dev/null || true; }
    RST=$(t sgr0);    BLD=$(t bold);     ITL=$(t sitm);
    RED=$(t setaf 1); GRN=$(t setaf 2);  YLW=$(t setaf 3);
    BLU=$(t setaf 4); CYN=$(t setaf 6);  DIM=$(t dim)
else
    BLD=; DIM=; ITL=; RST=; RED=; GRN=; YLW=; BLU=; CYN=
fi

say()    { printf '%s\n' "$*"; }
hdr()    { printf '\n%s%s%s\n' "$BLD$CYN" "$*" "$RST"; }
field()  { printf '  %s%-6s%s %s\n' "$DIM" "$1" "$RST" "$2"; }   # label + value
warn()   { printf '%swarning:%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()    { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit "${2:-1}"; }
# act <color> <label> <msg> -- an aligned, colorized action line
act()    { printf '  %s%-9s%s %s\n' "$1" "$2" "$RST" "$3"; }
tilde()  { case "$1" in "$HOME"|"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

usage() {
    cat <<EOF
${BLD}shed${RST} - manage shed dotfiles

${BLD}usage:${RST} shed [options] <command> [options] [path ...]

${BLD}commands:${RST}
  ${GRN}install${RST}     symlink shed dotfiles into \$HOME (merge-safe, idempotent;
              re-run any time to converge). from a terminal it shows
              what would change and asks before doing it
  ${GRN}ignore${RST}      add paths to the ignore set; with no paths, list it
  ${GRN}unignore${RST}    remove paths from the ignore set; with no paths, pick
              from a list
  ${GRN}uninstall${RST}   remove all symlinks shed created in \$HOME
  ${GRN}help${RST}        show this message

${BLD}options:${RST}
  -n, --dry-run           show what would change without touching anything
  -y, --yes               install: don't ask, take the default answers
  -S, --skip-modules      install: leave git submodules alone
  -a, --all               unignore: clear the entire ignore set
  -h, --help              show this message
EOF
}

# ---- args ------------------------------------------------------------------

CMD=""
DRY_RUN=0
YES=0
SKIP_SUBMODULES=0
ALL=0
PATHS=()

bad_usage() { printf '%serror:%s %s\n\n' "$RED" "$RST" "$*" >&2; usage >&2; exit 2; }

# options can sit before or after the command. the first bare word is the
# command; any bare words after it are paths.
for arg in "$@"; do
    case "$arg" in
        -h|--help)         usage; exit 0 ;;
        -n|--dry-run)      DRY_RUN=1 ;;
        -y|--yes)          YES=1 ;;
        -S|--skip-modules) SKIP_SUBMODULES=1 ;;
        -a|--all)          ALL=1 ;;
        -*)                bad_usage "unknown option: $arg" ;;
        *)
            if [ -z "$CMD" ]; then
                case "$arg" in
                    install|uninstall|ignore|unignore) CMD="$arg" ;;
                    help) usage; exit 0 ;;
                    *)    bad_usage "unknown command: $arg" ;;
                esac
                continue
            fi
            case "$CMD" in
                ignore|unignore) ;;
                *) bad_usage "$CMD takes no path arguments" ;;
            esac
            case "$arg" in
                "~")   arg="$HOME" ;;
                "~/"*) arg="$HOME/${arg#"~/"}" ;;
                /*)    ;;
                *)     arg="$PWD/$arg" ;;
            esac
            PATHS+=("${arg%/}")
            ;;
    esac
done

if [ -z "$CMD" ]; then usage >&2; exit 2; fi

# an option that doesn't apply to the command is an error, not a no-op
only_for() {    # only_for <value> <command> <option>
    if [ "$1" -eq 1 ] && [ "$CMD" != "$2" ]; then
        bad_usage "$3 only applies to $2"
    fi
}
only_for "$YES"             install  --yes
only_for "$SKIP_SUBMODULES" install  --skip-modules
only_for "$ALL"             unignore --all

# ---- locate shed -----------------------------------------------------------

# resolve this file's symlink chain to find the shed root. an already-exported
# SHED_ROOT is kept as a last-resort fallback in case resolution fails (e.g.
# this script got copied rather than linked somewhere along the way)
_shed_preset="${SHED_ROOT:-}"
_shed_src="${BASH_SOURCE[0]:-$0}"
while [ -L "$_shed_src" ]; do
    _shed_link="$(readlink "$_shed_src")"
    _shed_link="${_shed_link//\\//}"    # windows readlink may emit backslashes
    case "$_shed_link" in
        /*|[A-Za-z]:/*) _shed_src="$_shed_link" ;;    # absolute (posix or windows)
        *)              _shed_src="$(dirname "$_shed_src")/$_shed_link" ;;
    esac
done
SHED_ROOT="$(cd "$(dirname "$_shed_src")/.." >/dev/null 2>&1 && pwd)"

# validate against a sentinel file, not -d bin: a wrong root can still have a
# bin/ directory (SHED_ROOT=/ has /bin)
if [ ! -f "$SHED_ROOT/bin/whatsmyos" ]; then
    SHED_ROOT="$_shed_preset"
fi
[ -f "$SHED_ROOT/bin/whatsmyos" ] ||
    die "could not locate shed root (got \"$SHED_ROOT\"); export SHED_ROOT to override"
unset _shed_src _shed_link _shed_preset

SHED_OS="$(bash "$SHED_ROOT/bin/whatsmyos" 2>/dev/null || echo unknown)"
STAMP="$(date +%Y%m%d%H%M%S)"
MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/shed/manifest"
IGNORE="${XDG_CONFIG_HOME:-$HOME/.config}/shed/ignore"

run() { if [ "$DRY_RUN" -eq 1 ]; then printf '  %s[dry-run]%s %s\n' "$DIM" "$RST" "$*"; else "$@"; fi; }

# windows (git bash / msys): ln -s produces a COPY by default, which silently
# breaks shed's whole premise -- dotfiles must be real links for repo edits to
# propagate and for rc files to find the shed root via readlink. winsymlinks:
# nativestrict makes ln -s create native symlinks or fail, never copy. native
# symlinks need Developer Mode or an elevated shell, so probe up front and
# fail loudly with instructions instead of littering $HOME with dead copies.
require_real_symlinks() {
    [ "$SHED_OS" = windows ] || return 0
    export MSYS="${MSYS:+$MSYS }winsymlinks:nativestrict"
    export CYGWIN="${CYGWIN:+$CYGWIN }winsymlinks:nativestrict"
    local t; t="$(mktemp -d)"
    if ! ln -s "$SHED_ROOT" "$t/probe" 2>/dev/null || [ ! -L "$t/probe" ]; then
        rm -rf "$t"
        die "cannot create real symlinks on this system (msys ln -s would copy instead).
       enable Windows Developer Mode (Settings > System > For developers) or run
       from an elevated shell, then re-run shed install"
    fi
    rm -rf "$t"
}

# ---- ignore set -------------------------------------------------------------
#
# one path per line in $IGNORE. throughout, ${arr[@]+"${arr[@]}"} guards
# expansions: bash 3.2 treats an empty array as unset under set -u.

IGNORES=()

# returns 0 if path or any child is in IGNORES
is_ignored() {
    local p="${1%/}" i
    for i in ${IGNORES[@]+"${IGNORES[@]}"}; do
        case "$p" in "$i"|"$i"/*) return 0 ;; esac
    done
    return 1
}

read_ignore() {
    IGNORES=()
    [ -e "$IGNORE" ] || return 1
    if [ ! -r "$IGNORE" ]; then
        warn "ignore file exists but is unreadable: $IGNORE"
        return 2
    fi
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        IGNORES+=("${line%/}")
    done < "$IGNORE"
    return 0
}

# persist IGNORES; an empty set means no file at all
write_ignore() {
    [ "$DRY_RUN" -eq 1 ] && return 0
    local dir; dir="$(dirname "$IGNORE")"
    if [ "${#IGNORES[@]}" -eq 0 ]; then
        rm -f "$IGNORE" 2>/dev/null || true
        rmdir "$dir" 2>/dev/null || true
        return 0
    fi
    if ! mkdir -p "$dir" 2>/dev/null; then
        warn "could not create config dir $dir (ignore set not saved)"
        return 0
    fi
    printf '%s\n' "${IGNORES[@]}" > "$IGNORE" 2>/dev/null || warn "could not write ignore file: $IGNORE"
}

# ---- manifest --------------------------------------------------------------
#
# each line is "<dst>\t<srcrel>" where srcrel is the source path relative to the
# shed root (e.g. dot/.bashrc). srcrel lets us recognize a link as ours even
# after the shed directory has moved, since the tail of its target still matches.

MANIFEST_LINES=()   # collected as "<dst>\t<srcrel>" during a link pass

record_link() { MANIFEST_LINES+=("$1"$'\t'"$2"); }

# a link is "ours" if it's a symlink whose target's tail matches the srcrel we
# recorded -- true whether it points at the current shed root or a stale one.
is_our_link() {
    local dst="$1" srcrel="$2" tgt
    [ -L "$dst" ] || return 1
    tgt="$(readlink "$dst")"
    tgt="${tgt//\\//}"    # native windows symlinks can read back with backslashes
    case "$tgt" in
        */"$srcrel"|"$srcrel") return 0 ;;
        *) return 1 ;;
    esac
}

# read the manifest into parallel arrays MF_DST / MF_REL; tolerates absence and
# reports (without failing) when the file exists but can't be read.
MF_DST=(); MF_REL=()
read_manifest() {
    MF_DST=(); MF_REL=()
    [ -e "$MANIFEST" ] || return 1
    if [ ! -r "$MANIFEST" ]; then
        warn "manifest exists but is unreadable: $MANIFEST"
        return 2
    fi
    local dst rel
    while IFS=$'\t' read -r dst rel || [ -n "$dst" ]; do
        [ -n "$dst" ] || continue
        MF_DST+=("$dst"); MF_REL+=("$rel")
    done < "$MANIFEST"
    return 0
}

# dedupe by dst keeping the last (highest-precedence) entry, preserving order
write_manifest() {
    [ "$DRY_RUN" -eq 1 ] && return 0
    local dir; dir="$(dirname "$MANIFEST")"
    if ! mkdir -p "$dir" 2>/dev/null; then
        warn "could not create state dir $dir (skipping manifest)"
        warn "(uninstall won't be able to find these links later)"
        return 0
    fi
    local content=""
    if [ "${#MANIFEST_LINES[@]}" -gt 0 ]; then
        content="$(printf '%s\n' "${MANIFEST_LINES[@]}" |
            awk -F'\t' '{l[NR]=$0; k[NR]=$1; last[$1]=NR}
                        END{for(i=1;i<=NR;i++) if(last[k[i]]==i) print l[i]}')"
    fi
    if [ -n "$content" ]; then
        printf '%s\n' "$content" > "$MANIFEST" 2>/dev/null || warn "could not write manifest: $MANIFEST"
    else
        : > "$MANIFEST" 2>/dev/null || warn "could not write manifest: $MANIFEST"
    fi
}

# ---- prompts ---------------------------------------------------------------
#
# install asks before it changes anything, but only when someone is there to
# answer: a terminal on both ends, and neither --yes nor --dry-run. otherwise
# every question takes its default.

INTERACTIVE=0

# ask <question> <default: y|n> -- returns 0 for yes
ask() {
    local q="$1" def="$2" hint="y/N" reply
    [ "$def" = y ] && hint="Y/n"
    if [ "$INTERACTIVE" -eq 1 ]; then
        while :; do
            printf '  %s?%s %s? [%s] ' "$BLD$BLU" "$RST" "$q" "$hint"
            read -r reply || { reply=""; printf '\n'; }
            case "$reply" in
                y|Y|yes|Yes|YES) return 0 ;;
                n|N|no|No|NO)    return 1 ;;
                "")              break ;;
            esac
        done
    fi
    [ "$def" = y ]
}

# choose <question> <default letter> <valid letters> -- sets CHOICE
CHOICE=""
choose() {
    local q="$1" def="$2" valid="$3" reply
    CHOICE="$def"
    [ "$INTERACTIVE" -eq 1 ] || return 0
    while :; do
        printf '  %s?%s %s [%s] ' "$BLD$BLU" "$RST" "$q" "$def"
        read -r reply || { reply=""; printf '\n'; }
        [ -n "$reply" ] || return 0
        reply="$(printf '%s' "$reply" | tr 'A-Z' 'a-z')"
        reply="${reply:0:1}"
        case "$valid" in *"$reply"*) CHOICE="$reply"; return 0 ;; esac
    done
}

# ---- linking ---------------------------------------------------------------
#
# install runs in three steps, so it can show (and ask about) every change
# before it touches $HOME: collect each source/destination pair, plan what
# each one needs, then apply.
#
# P_STATE, per pair:
#   lost     a higher-precedence source claimed the same destination
#   same     already linked correctly
#   new      nothing at the destination yet
#   repoint  shed's own link, but pointing at the wrong place (the shed dir
#            moved, or a different source now wins this destination)
#   replace  the user has something there; it is backed up, then replaced
#   skip     the user chose to leave the destination alone

P_SRC=(); P_DST=(); P_STATE=()
PRUNE=()            # old shed links to remove
NEW_DSTS=$'\n'      # newline-delimited destinations shed owns after this run
CHANGES=0
IGNORE_CHANGED=0

# pairs arrive in ascending precedence, so a later one takes the destination
add_pair() {
    local src="$1" dst="$2" i
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        if [ "${P_DST[$i]}" = "$dst" ]; then P_STATE[$i]=lost; fi
    done
    P_SRC+=("$src"); P_DST+=("$dst"); P_STATE+=("")
}

# a dot/ tree mirrors into $HOME file by file
collect_tree() {
    local root="$1" f dst
    [ -d "$root" ] || return 0
    while IFS= read -r -d '' f; do
        dst="$HOME/${f#"$root"/}"
        if is_ignored "$dst"; then
            continue
        fi
        add_pair "$f" "$dst"
    done < <(find "$root" -type f -print0)
}

# agent instruction files don't mirror into $HOME the way dot/ does.
# instead, we read "<source> <destination>" pairs from <root>/links, where 
# source is relative to <root> and destination relative to $HOME.
collect_map() {
    local root="$1" src dst
    [ -f "$root/links" ] || return 0
    while read -r src dst || [ -n "$src" ]; do
        case "$src" in ""|"#"*) continue ;; esac
        if [ -z "$dst" ]; then
            warn "${root#$SHED_ROOT/}/links: no destination for $src"
            continue
        fi
        if [ ! -f "$root/$src" ]; then
            warn "${root#$SHED_ROOT/}/links: no such source: $src"
            continue
        fi
        dst="$HOME/${dst#/}"
        if is_ignored "$dst"; then
            continue
        fi
        add_pair "$root/$src" "$dst"
    done < "$root/links"
}

# ascending precedence: base, then os-specific, then private
collect_all() {
    P_SRC=(); P_DST=(); P_STATE=()
    collect_tree "$SHED_ROOT/dot"
    collect_tree "$SHED_ROOT/os/$SHED_OS/dot"
    collect_tree "$SHED_ROOT/private/dot"
    collect_map  "$SHED_ROOT/agents"
    collect_map  "$SHED_ROOT/private/agents"
}

# did shed create the symlink at dst? yes if it points at the source we are
# about to link there, or at the source the manifest lists for dst
shed_owns() {
    local dst="$1" srcrel="$2" i
    if is_our_link "$dst" "$srcrel"; then return 0; fi
    for ((i = 0; i < ${#MF_DST[@]}; i++)); do
        if [ "${MF_DST[$i]}" = "$dst" ] && is_our_link "$dst" "${MF_REL[$i]}"; then
            return 0
        fi
    done
    return 1
}

plan_pairs() {
    local i src dst cur
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        [ -z "${P_STATE[$i]}" ] || continue
        src="${P_SRC[$i]}"; dst="${P_DST[$i]}"
        if [ -L "$dst" ]; then
            cur="$(readlink "$dst")"
            cur="${cur//\\//}"    # native windows symlinks can read back with backslashes
            if [ "$cur" = "$src" ]; then
                P_STATE[$i]=same
            elif shed_owns "$dst" "${src#"$SHED_ROOT"/}"; then
                P_STATE[$i]=repoint
            else
                P_STATE[$i]=replace
            fi
        elif [ -e "$dst" ]; then
            P_STATE[$i]=replace
        else
            P_STATE[$i]=new
        fi
    done
}

# where the user already has something at a destination, let them decide
resolve_conflicts() {
    [ "$INTERACTIVE" -eq 1 ] || return 0
    local i dst first=1
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        [ "${P_STATE[$i]}" = replace ] || continue
        dst="${P_DST[$i]}"
        if [ "$first" -eq 1 ]; then hdr "conflicts"; first=0; fi
        printf '  %s%s%s already exists and is not a shed link.\n' "$BLD" "$(tilde "$dst")" "$RST"
        choose "[r]eplace it (a backup is kept), [s]kip it this time, or [i]gnore it from now on?" r rsi
        case "$CHOICE" in
            s) P_STATE[$i]=skip ;;
            i) P_STATE[$i]=skip; IGNORES+=("$dst"); IGNORE_CHANGED=1 ;;
        esac
    done
}

# tracked links that shouldn't exist anymore: destination now ignored (evict
# -- that territory is the user's) or source gone from the shed tree. only
# ever lists links that are ours.
plan_prunes() {
    PRUNE=(); NEW_DSTS=$'\n'
    local i
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        case "${P_STATE[$i]}" in lost|skip) continue ;; esac
        NEW_DSTS="$NEW_DSTS${P_DST[$i]}"$'\n'
    done
    for ((i = 0; i < ${#MF_DST[@]}; i++)); do
        case "$NEW_DSTS" in *$'\n'"${MF_DST[$i]}"$'\n'*) continue ;; esac
        is_our_link "${MF_DST[$i]}" "${MF_REL[$i]}" || continue
        PRUNE+=("${MF_DST[$i]}")
    done
}

show_plan() {
    local i dst from same=0 b
    CHANGES=0
    hdr "changes"
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        dst="${P_DST[$i]}"
        from="$DIM<- ${P_SRC[$i]#"$SHED_ROOT"/}$RST"
        case "${P_STATE[$i]}" in
            same)    same=$((same + 1)); continue ;;
            new)     act "$GRN" "link:"    "${dst#"$HOME"/} $from" ;;
            repoint) act "$YLW" "repoint:" "${dst#"$HOME"/} $from" ;;
            replace) act "$YLW" "replace:" "${dst#"$HOME"/} $from"
                     printf '            %syours is kept as %s.bak.%s%s\n' "$DIM" "${dst##*/}" "$STAMP" "$RST" ;;
            skip)    act "$DIM" "skip:"    "${dst#"$HOME"/} (left alone)"; continue ;;
            *)       continue ;;
        esac
        CHANGES=$((CHANGES + 1))
    done
    for dst in ${PRUNE[@]+"${PRUNE[@]}"}; do
        if is_ignored "$dst"; then
            act "$YLW" "evict:" "${dst#"$HOME"/} (now ignored)"
            for b in "$dst".bak.*; do
                [ -e "$b" ] &&
                    printf '            %sbackup left in place: %s%s\n' "$DIM" "${b#"$HOME"/}" "$RST"
            done
        else
            act "$RED" "remove:" "${dst#"$HOME"/} (no longer in shed)"
        fi
        CHANGES=$((CHANGES + 1))
    done
    if [ "$CHANGES" -eq 0 ]; then
        printf '  %snone: %d link(s) already in place%s\n' "$DIM" "$same" "$RST"
    elif [ "$same" -gt 0 ]; then
        printf '  %s(%d more already in place)%s\n' "$DIM" "$same" "$RST"
    fi
}

apply_plan() {
    local i src dst dir
    for ((i = 0; i < ${#P_DST[@]}; i++)); do
        src="${P_SRC[$i]}"; dst="${P_DST[$i]}"
        case "${P_STATE[$i]}" in lost|skip) continue ;; esac
        record_link "$dst" "${src#"$SHED_ROOT"/}"
        [ "$DRY_RUN" -eq 0 ] || continue
        case "${P_STATE[$i]}" in
            same)    continue ;;
            repoint) rm -f "$dst" ;;
            replace) mv "$dst" "$dst.bak.$STAMP" ;;
        esac
        dir="$(dirname "$dst")"
        [ -d "$dir" ] || mkdir -p "$dir"
        ln -s "$src" "$dst"
    done
    [ "$DRY_RUN" -eq 0 ] || return 0
    for dst in ${PRUNE[@]+"${PRUNE[@]}"}; do
        rm -f "$dst"
    done
}

# warn about bootstrap-critical files that didn't get linked -- without them,
# shed never lands on PATH. the files self-identify with a "shed:bootstrap"
# marker comment, so the list lives in the dotfiles, not here. $1 is the
# newline-delimited set of destinations linked this run.
check_bootstrap() {
    local root f dst
    for root in "$SHED_ROOT/dot" "$SHED_ROOT/os/$SHED_OS/dot" "$SHED_ROOT/private/dot"; do
        [ -d "$root" ] || continue
        while IFS= read -r f; do
            dst="$HOME/${f#"$root"/}"
            case "$1" in *$'\n'"$dst"$'\n'*) continue ;; esac
            if is_ignored "$dst"; then
                warn "$(tilde "$dst") is ignored; it's what puts shed on PATH (wire up $SHED_ROOT/bin yourself)"
            else
                warn "$(tilde "$dst") did not get linked; shed may not be on PATH"
            fi
        done < <(grep -rl 'shed:bootstrap' "$root" 2>/dev/null || true)
    done
}

# secure ssh: dir 700, and repo-side files 600 (ssh checks the real file)
secure_ssh() {
    local sshdir="$HOME/.ssh"
    if is_ignored "$sshdir"; then return 0; fi
    [ -e "$sshdir" ] || return 0
    hdr "securing ~/.ssh"
    run chmod 700 "$sshdir"
    local d f
    for d in "$SHED_ROOT/dot/.ssh" "$SHED_ROOT/os/$SHED_OS/dot/.ssh" "$SHED_ROOT/private/dot/.ssh"; do
        [ -d "$d" ] || continue
        while IFS= read -r -d '' f; do
            run chmod 600 "$f"
        done < <(find "$d" -type f -print0)
    done
}

# ---- submodules ------------------------------------------------------------

update_submodule() {
    local path="$1"
    if [ "$DRY_RUN" -eq 1 ]; then
        run git -C "$SHED_ROOT" submodule update --init --recursive -- "$path"
    elif ! git -C "$SHED_ROOT" submodule update --init --recursive -- "$path"; then
        printf '%s\n' "$YLW"
        say "| Could not update $path. Do you have access?"
        say "| We'll skip for now. Once you can reach the repo, run:"
        say "|   git -C \"$SHED_ROOT\" submodule update --init --recursive -- \"$path\""
        say "| then re-run shed install."
        printf '%s\n' "$RST"
    fi
}

# shed pins each submodule to one commit. report where each one stands
# against its pin, and offer to fix the ones that are off:
#   not downloaded  never checked out here                (default: fetch it)
#   behind          the pin is newer, not fetched yet     (default: fetch it)
#   behind          the pin is newer, already fetched     (default: update it)
#   ahead           the submodule has newer commits of its own, so an update
#                   would move it backward                (default: leave it)
sync_submodules() {
    [ -f "$SHED_ROOT/.gitmodules" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    if [ "$SKIP_SUBMODULES" -eq 1 ]; then
        hdr "modules $ITL(skipped)$RST"
    else
        hdr "modules"
    fi

    # read the list up front: the questions below need stdin for themselves
    local lines=() line
    while IFS= read -r line; do
        lines+=("$line")
    done < <(git -C "$SHED_ROOT" submodule status 2>/dev/null || true)

    local flag path sub rec state q def
    for line in ${lines[@]+"${lines[@]}"}; do
        flag="${line:0:1}"
        path="${line:1}"; path="${path#* }"; path="${path% (*}"
        sub="$SHED_ROOT/$path"
        q=""; def=n
        case "$flag" in
            -)  state="not downloaded"; q="fetch '$path'"; def=y ;;
            +)  rec="$(git -C "$SHED_ROOT" ls-files -s -- "$path" | awk '{print $2}')"
                if ! git -C "$sub" cat-file -e "$rec^{commit}" 2>/dev/null; then
                    state="behind the pinned commit (not fetched yet)"
                    q="fetch and update '$path'"; def=y
                elif git -C "$sub" merge-base --is-ancestor HEAD "$rec" 2>/dev/null; then
                    state="behind the pinned commit"
                    q="update '$path'"; def=y
                else
                    state="ahead of the pinned commit"
                    q="move '$path' back to the pinned commit"; def=n
                fi ;;
            U)  state="merge conflict (resolve by hand)" ;;
            *)  state="up to date" ;;
        esac
        if [ "$flag" != "-" ] && [ -n "$(git -C "$sub" status --porcelain 2>/dev/null)" ]; then
            state="$state (has uncommitted changes)"
        fi
        printf '  %s%-14s%s %s\n' "$DIM" "$path" "$RST" "$state"
        [ -n "$q" ] || continue
        [ "$SKIP_SUBMODULES" -eq 0 ] || continue
        if ask "$q" "$def"; then
            update_submodule "$path"
        fi
    done
}

# ---- shared preamble / epilogue -------------------------------------------

preamble() {
    printf '%senvironment%s\n' "$BLD$CYN" "$RST"
    field "os"   "$SHED_OS"
    field "shed" "$SHED_ROOT"
    local i label="ignore"
    for i in ${IGNORES[@]+"${IGNORES[@]}"}; do
        field "$label" "$(tilde "$i")"
        label=""
    done
    if [ "$DRY_RUN" -eq 1 ]; then printf '  %s(dry run, nothing will change)%s\n' "$DIM" "$RST"; fi
}

epilogue() {
    hdr "done"
    say "$*"
    [ "$DRY_RUN" -eq 1 ] && printf '%s(re-run without -n to apply)%s\n' "$DIM" "$RST" || true
}

# ---- commands --------------------------------------------------------------

cmd_install() {
    require_real_symlinks
    read_ignore || true

    if [ "$YES" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
        INTERACTIVE=1
    fi

    preamble
    sync_submodules

    # previous links, to converge against
    read_manifest || true

    collect_all
    plan_pairs
    resolve_conflicts
    plan_prunes
    show_plan

    if [ "$CHANGES" -gt 0 ] && [ "$INTERACTIVE" -eq 1 ]; then
        if ! ask "apply $CHANGES change(s)" y; then
            say "nothing changed."
            return 0
        fi
    fi

    if [ "$IGNORE_CHANGED" -eq 1 ]; then write_ignore; fi
    apply_plan
    write_manifest
    secure_ssh
    check_bootstrap "$NEW_DSTS"

    epilogue "${#MANIFEST_LINES[@]} dotfile(s) linked, $CHANGES change(s)"
    if [ "$DRY_RUN" -eq 0 ] && [ "$CHANGES" -gt 0 ]; then
        printf '%s(open a new shell, or exec $SHELL, to pick up PATH changes)%s\n' "$DIM" "$RST"
    fi
}

cmd_ignore() {
    read_ignore || true

    if [ "${#PATHS[@]}" -eq 0 ]; then
        if [ "${#IGNORES[@]}" -eq 0 ]; then
            say "nothing is ignored."
        else
            local i
            for i in "${IGNORES[@]}"; do printf '  %s\n' "$(tilde "$i")"; done
        fi
        return 0
    fi

    local p added=0
    for p in "${PATHS[@]}"; do
        if is_ignored "$p"; then
            act "$DIM" "kept:" "$(tilde "$p") (already ignored)"
        else
            IGNORES+=("$p")
            act "$YLW" "ignore:" "$(tilde "$p")"
            added=$((added + 1))
        fi
    done
    write_ignore

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '%s(dry run, ignore set unchanged)%s\n' "$DIM" "$RST"
    elif [ "$added" -gt 0 ]; then
        say "run ${BLD}shed install${RST} to apply (evicts shed links under ignored paths)"
    fi
}

cmd_unignore() {
    read_ignore || true

    if [ "${#IGNORES[@]}" -eq 0 ]; then
        say "nothing is ignored."
        return 0
    fi

    local -a drop=()
    local p i
    if [ "$ALL" -eq 1 ]; then
        drop=("${IGNORES[@]}")
    elif [ "${#PATHS[@]}" -gt 0 ]; then
        local found
        for p in "${PATHS[@]}"; do
            found=0
            for i in "${IGNORES[@]}"; do
                [ "$i" = "$p" ] && { drop+=("$p"); found=1; break; }
            done
            if [ "$found" -eq 0 ]; then
                if is_ignored "$p"; then
                    warn "$(tilde "$p") is covered by a parent entry; unignore that instead"
                else
                    warn "$(tilde "$p") is not ignored"
                fi
            fi
        done
    else
        [ -t 0 ] || die "no terminal to pick from; pass paths or --all"
        for ((i = 0; i < ${#IGNORES[@]}; i++)); do
            printf '  %s%2d)%s %s\n' "$DIM" "$((i + 1))" "$RST" "$(tilde "${IGNORES[$i]}")"
        done
        printf 'unignore which? [numbers, %sa%sll, enter to cancel] ' "$BLD" "$RST"
        local reply n
        read -r reply || reply=""
        case "$reply" in
            "")    say "canceled."; return 0 ;;
            a|all) drop=("${IGNORES[@]}") ;;
            *)
                for n in ${reply//,/ }; do
                    case "$n" in *[!0-9]*|"") die "invalid selection: $n" ;; esac
                    if [ "$n" -lt 1 ] || [ "$n" -gt "${#IGNORES[@]}" ]; then
                        die "out of range: $n"
                    fi
                    drop+=("${IGNORES[$((n - 1))]}")
                done
                ;;
        esac
    fi

    [ "${#drop[@]}" -gt 0 ] || return 0

    local -a keep=()
    local d hit removed=0
    for i in "${IGNORES[@]}"; do
        hit=0
        for d in "${drop[@]}"; do [ "$d" = "$i" ] && { hit=1; break; }; done
        if [ "$hit" -eq 1 ]; then
            act "$GRN" "unignore:" "$(tilde "$i")"
            removed=$((removed + 1))
        else
            keep+=("$i")
        fi
    done
    IGNORES=(${keep[@]+"${keep[@]}"})
    write_ignore

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '%s(dry run, ignore set unchanged)%s\n' "$DIM" "$RST"
    elif [ "$removed" -gt 0 ]; then
        say "run ${BLD}shed install${RST} to link into these paths again"
    fi
}

cmd_uninstall() {
    read_ignore || true
    preamble

    local rc=0
    read_manifest || rc=$?
    if [ "$rc" -ne 0 ]; then
        case "$rc" in
            2) die "cannot uninstall without a readable manifest" ;;
            *) hdr "nothing to do"
               say "no manifest at $MANIFEST"
               say "(run 'shed install' first)"
               return 0 ;;
        esac
    fi
    if [ "${#MF_DST[@]}" -eq 0 ]; then
        hdr "nothing to do"
        say "manifest is empty."
        run rm -f "$MANIFEST"
        return 0
    fi

    hdr "removing links"
    local i dst rel removed=0 kept=0 baks=() b
    for ((i = 0; i < ${#MF_DST[@]}; i++)); do
        dst="${MF_DST[$i]}"; rel="${MF_REL[$i]}"
        if is_our_link "$dst" "$rel"; then
            act "$RED" "remove:" "${dst#$HOME/}"
            run rm -f "$dst"
            removed=$((removed + 1))
        elif [ -e "$dst" ] || [ -L "$dst" ]; then
            act "$DIM" "skip:" "${dst#$HOME/} (not a shed link, left alone)"
            kept=$((kept + 1))
        fi
        for b in "$dst".bak.*; do [ -e "$b" ] && baks+=("$b"); done
    done

    if [ "${#baks[@]}" -gt 0 ]; then
        hdr "backups left in place"
        say "restore any of these by hand if you want them back:"
        for b in "${baks[@]}"; do printf '  %s%s%s\n' "$DIM" "$b" "$RST"; done
    fi

    run rm -f "$MANIFEST"

    local extra=""
    [ "$kept" -gt 0 ] && extra=", left $kept untouched"
    epilogue "removed $removed link(s)$extra"
}

case "$CMD" in
    install)   cmd_install ;;
    ignore)    cmd_ignore ;;
    unignore)  cmd_unignore ;;
    uninstall) cmd_uninstall ;;
esac
